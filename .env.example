APP_NAME=GadgetBekas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite supaya bisa langsung jalan. Untuk MySQL/PostgreSQL ganti DB_CONNECTION dan isi DB_HOST dst.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Akun admin yang dibuat oleh `php artisan db:seed`. GANTI sebelum dipakai sungguhan.
ADMIN_NAME="Admin Toko"
ADMIN_EMAIL=admin@gadgetbekas.test
ADMIN_PASSWORD=ganti-password-ini

# Info toko yang tampil di situs
SHOP_NAME=GadgetBekas
SHOP_WHATSAPP=6281200000000
SHOP_ADDRESS="Jl. Contoh No. 12, Magetan"
SHOP_HOURS="Setiap hari, 09.00-20.00 WIB"
